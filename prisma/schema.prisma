generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Ngo {
    id        Int        @id @default(autoincrement())
    name      String
    city      String
    address   String
    contact   String
    needs     String
    lat       Float
    lng       Float
    donations Donation[]
    createdAt DateTime   @default(now())
}

model Donation {
    id        Int      @id @default(autoincrement())
    donor     String
    item      String
    quantity  Int
    status    String   @default("Confirmado")
    date      DateTime @default(now())
    ngoId     Int
    ngo       Ngo      @relation(fields: [ngoId], references: [id])
}

model InventoryItem {
    id          Int    @id @default(autoincrement())
    item        String @unique
    total       Int    @default(0)
    distributed Int    @default(0)
    available   Int    @default(0)
}